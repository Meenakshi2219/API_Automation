              "const randomPrice=()=>Number((Math.random()*999+1).toFixed(2));\r",
              "\r",
              "const randomBoolean=()=>Math.random()>=0.5;\r",
              "\r",
              "let name=randomString(\"Product\");\r",
              "\r",
              "let category=randomString(\"Category\");\r",
              "\r",
              "let price=randomPrice();\r",
              "\r",
              "let instock=randomBoolean();\r",
              "\r",
              "let expectedStatus=200;\r",
              "\r",
              "if(i===0){\r",
              "\r",
              "    name=randomNumber();\r",
              "\r",
              "    expectedStatus=400;\r",
              "\r",
              "}else if(i===1){\r",
              "\r",
              "    category=randomNumber();\r",
              "\r",
              "    expectedStatus=400;\r",
              "\r",
              "}else if(i===2){\r",
              "\r",
