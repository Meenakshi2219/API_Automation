    {
      "name": "Get Record",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const record = response.data;",
              "const product = record.data;",
              "",
              "pm.test(\"GET - Status code validation\", function () {",
              "pm.expect(pm.response.code).to.eql(200);",
              "",
              "});",
              "",
              "pm.test(\"GET - Response is JSON\", function () {",
              "pm.response.to.be.json;",
              "",
              "});",
              "",
              "pm.test(\"GET - Response data validation\", function () {",
              "pm.expect(response).to.have.property(\"data\");",
              "pm.expect(record).to.have.property(\"id\");",
              "pm.expect(record).to.have.property(\"data\");",
              "",
              "});",
              "",
              "const schema = {",
              "",
              "    type: \"object\",",
              "    required: [\"data\"],",
              "    properties: {",
              "",
              "        data: {",
              "           type: \"object\",",
              "           required: [\"id\", \"collection_id\", \"project_id\", \"data\"],",
              "      properties: {",
              "             id: { type: \"string\" },",
              "             collection_id: { type: \"string\" },",
              "             project_id: { type: \"number\" },",
              "",
              "data: {",
              "type: \"object\",",
              "required: [\"name\", \"price\", \"instock\", \"category\"],",
              "",
              "    properties: {",
              "      name: { type: \"string\" },",
              "      price: { type: \"number\" },",
              "      instock: { type: \"boolean\" },",
              "      category: { type: \"string\" }",
              "  }",
              " }",
              " }} }",
              "",
              "};",
              "",
              "pm.test(\"GET - Schema validation\", function () {",
              "pm.response.to.have.jsonSchema(schema);",
              "",
              "});",
              "",
              "pm.test(\"GET - ID validation\", function () {",
              "pm.expect(record.id).to.be.a(\"string\");",
              "pm.expect(record.id).to.eql(pm.environment.get(\"created_id\")",
              "",
              "    );",
              "",
              "});",
              "",
              "pm.test(\"GET - Name validation\", function () {",
              "pm.expect(product.name).to.exist;",
              "pm.expect(product.name).to.be.a(\"string\");",
              "pm.expect(product.name).to.not.be.empty;",
              "",
              "});",
              "",
              "pm.test(\"GET - Category validation\", function () {",
              "pm.expect(product.category).to.exist;",
              "pm.expect(product.category).to.be.a(\"string\");",
              "pm.expect(product.category).to.not.be.empty;",
              "",
              "});",
              "",
              "pm.test(\"GET - Price validation\", function () {",
              "pm.expect(product.price).to.be.a(\"number\");",
              "pm.expect(product.price.toString()).to.match(/^\\d+(\\.\\d{1,2})?$/",
              "",
              "    );",
              "",
              "});",
              "",
              "pm.test(\"GET - InStock validation\", function () {",
              "pm.expect(product.instock).to.be.a(\"boolean\");",
              "",
              "});",
              "",
              "pm.test(\"GET - Name matches created record\", function () {",
              "pm.expect(product.name).to.eql(pm.environment.get(\"created_name\")",
              "",
              "    );",
              "",
              "});",
              "",
              "pm.test(\"GET - Category matches created record\", function () {",
              "pm.expect(product.category).to.eql(pm.environment.get(\"created_category\")",
              "",
              "    );",
              "",
              "});",
              "",
              "pm.test(\"GET - Price matches created record\", function () {",
              "pm.expect(product.price).to.eql(Number(pm.environment.get(\"created_price\"))",
              "",
              "    );",
              "",
              "});",
              "",
