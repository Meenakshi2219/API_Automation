        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const i = pm.info.iteration;\r",
              "function randomString(length) {\r",
              "\r",
              "    const chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\";\r",
              "    let result = \"\";\r",
              "    for (let j = 0; j < length; j++) {\r",
              "     result += chars.charAt(Math.floor(Math.random() * chars.length));\r",
              "\r",
              "    }\r",
              "return result;\r",
              "\r",
              "}\r",
              "\r",
              "function randomName() {\r",
              "\r",
              "return \"Product_\" + randomString(6) + \"_\" +\r",
              "Math.floor(1000 + Math.random() * 9000);\r",
              "\r",
              "}\r",
              "\r",
              "function randomCategory() {\r",
              "return \"Category_\" + randomString(5);\r",
              "\r",
              "}\r",
              "\r",
              "function randomPrice() {\r",
              "return Number((Math.random() * 999 + 1).toFixed(2));\r",
              "\r",
              "}\r",
              "\r",
              "function randomBoolean() {\r",
              "return Math.random() < 0.5;\r",
              "\r",
              "}\r",
              "\r",
              "let name = randomName();\r",
              "let category = randomCategory();\r",
              "let price = randomPrice();\r",
              "let instock = randomBoolean();\r",
              "let expectedStatus = 201;\r",
              "\r",
              "if (i === 0) {\r",
              "\r",
              "name = \"\";\r",
              "expectedStatus = 400;\r",
              "\r",
              "} else if (i === 1) {\r",
              "\r",
              "category = \"\";\r",
              "expectedStatus = 400;\r",
              "\r",
              "} else if (i === 2) {\r",
              "\r",
              "price = Number((Math.random() * 999 + 1).toFixed(5));\r",
              "expectedStatus = 400;\r",
              "\r",
              "} else if (i === 3) {\r",
              "\r",
              "instock = randomString(5);\r",
              "expectedStatus = 400;\r",
              "\r",
              "} else {\r",
              "\r",
              "expectedStatus = 201;\r",
              "\r",
              "}\r",
              "\r",
              "pm.variables.set(\"post_name\", name);\r",
              "pm.variables.set(\"post_category\", category);\r",
              "pm.variables.set(\"post_price\", price);\r",
              "pm.variables.set(\"post_instock\", JSON.stringify(instock));\r",
              "pm.variables.set(\"post_expected_status\", expectedStatus);\r",
              "\r",
              "console.log(\"Iteration:\", i + 1);\r",
              "console.log(\"Name:\", name);\r",
              "console.log(\"Category:\", category);\r",
              "console.log(\"Price:\", price);\r",
              "console.log(\"Instock:\", instock);\r",
              "console.log(\"Expected Status:\", expectedStatus);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
