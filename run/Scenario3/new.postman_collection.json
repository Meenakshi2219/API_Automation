        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "(function () {\r",
              "\r",
              "function randomString(prefix) {\r",
              "\r",
              "    return prefix + \"_\" + Math.random().toString(36).substring(2, 10);\r",
              "\r",
              "}\r",
              "\r",
              "function randomValidPrice() {\r",
              "\r",
              "    return Number((Math.random() * 9999).toFixed(2));\r",
              "\r",
              "}\r",
              "\r",
              "function randomInvalidName() {\r",
              "\r",
              "    var values = [\"\", \"@\", \"#\", \"$\", \"%\", \"!\", \"*\"];\r",
              "\r",
              "    return values[Math.floor(Math.random() * values.length)];\r",
              "\r",
              "}\r",
              "\r",
              "function randomInvalidCategory() {\r",
              "\r",
              "    var values = [\"\", \"@\", \"#\", \"$\", \"%\", \"!\", \"*\"];\r",
              "\r",
              "    return values[Math.floor(Math.random() * values.length)];\r",
              "\r",
              "}\r",
              "\r",
              "function randomInvalidPrice() {\r",
              "\r",
              "    return -Number((Math.random() * 9999).toFixed(2));\r",
              "\r",
              "}\r",
              "\r",
              "var iteration = pm.info.iteration;\r",
              "\r",
              "var startType = pm.environment.get(\"post_start_type\");\r",
              "\r",
              "if (iteration === 0) {\r",
              "\r",
              "    startType = Math.random() < 0.5 ? \"positive\" : \"negative\";\r",
              "\r",
              "    pm.environment.set(\"post_start_type\", startType);\r",
              "\r",
              "}\r",
              "\r",
              "var isPositive;\r",
              "\r",
              "if (startType === \"positive\") {\r",
              "\r",
              "    isPositive = iteration % 2 === 0;\r",
              "\r",
              "} else {\r",
              "\r",
              "    isPositive = iteration % 2 !== 0;\r",
              "\r",
              "}\r",
              "\r",
              "var instock = Math.random() < 0.5;\r",
              "\r",
              "if (isPositive) {\r",
              "\r",
              "    pm.variables.set(\"post_name\", randomString(\"Product\"));\r",
              "\r",
              "    pm.variables.set(\"post_category\", randomString(\"Category\"));\r",
              "\r",
              "    pm.variables.set(\"post_price\", randomValidPrice());\r",
              "\r",
              "    pm.variables.set(\"post_test_type\", \"positive\");\r",
              "\r",
              "    pm.variables.set(\"post_expected_status\", \"201\");\r",
              "\r",
              "    pm.environment.set(\"post_run_type\", \"positive\");\r",
              "\r",
              "} else {\r",
              "\r",
              "    var invalidField = Math.floor(Math.random() * 3);\r",
              "\r",
              "    if (invalidField === 0) {\r",
              "\r",
              "        pm.variables.set(\"post_name\", randomInvalidName());\r",
              "\r",
              "        pm.variables.set(\"post_category\", randomString(\"Category\"));\r",
              "\r",
              "        pm.variables.set(\"post_price\", randomValidPrice());\r",
              "\r",
              "    } else if (invalidField === 1) {\r",
              "\r",
              "        pm.variables.set(\"post_name\", randomString(\"Product\"));\r",
              "\r",
              "        pm.variables.set(\"post_category\", randomInvalidCategory());\r",
              "\r",
              "        pm.variables.set(\"post_price\", randomValidPrice());\r",
              "\r",
              "    } else {\r",
              "\r",
              "        pm.variables.set(\"post_name\", randomString(\"Product\"));\r",
              "\r",
              "        pm.variables.set(\"post_category\", randomString(\"Category\"));\r",
              "\r",
              "        pm.variables.set(\"post_price\", randomInvalidPrice());\r",
              "\r",
              "    }\r",
              "\r",
              "    pm.variables.set(\"post_test_type\", \"negative\");\r",
              "\r",
              "    pm.variables.set(\"post_expected_status\", \"400\");\r",
              "\r",
              "    pm.environment.set(\"post_run_type\", \"negative\");\r",
              "\r",
              "}\r",
              "\r",
              "pm.variables.set(\"post_instock\", instock);\r",
              "\r",
              "})();"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
