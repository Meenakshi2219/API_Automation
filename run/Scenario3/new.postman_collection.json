              "",
              "    });",
              "",
              "}",
              "",
              "if (response.data && response.data.data) {",
              "",
              "    var schema = {",
              "",
              "        type: \"object\",",
              "",
              "        required: [\"data\"],",
              "",
              "        properties: {",
