    {
      "name": "Update record",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "(function () {\r",
              "\r",
              "function randomString(prefix) {\r",
              "\r",
              "    return prefix + \"_\" + Math.random().toString(36).substring(2, 10);\r",
              "\r",
              "}\r",
              "\r",
              "function randomValidPrice() {\r",
              "\r",
              "    return Number((Math.random() * 9999).toFixed(2));\r",
              "\r",
              "}\r",
              "\r",
              "function randomInvalidName() {\r",
              "\r",
              "    var values = [\"\", \"@\", \"#\", \"$\", \"%\", \"!\", \"*\"];\r",
              "\r",
              "    return values[Math.floor(Math.random() * values.length)];\r",
              "\r",
              "}\r",
              "\r",
              "function randomInvalidCategory() {\r",
              "\r",
              "    var values = [\"\", \"@\", \"#\", \"$\", \"%\", \"!\", \"*\"];\r",
              "\r",
              "    return values[Math.floor(Math.random() * values.length)];\r",
              "\r",
              "}\r",
              "\r",
              "function randomInvalidPrice() {\r",
              "\r",
              "    return -Number((Math.random() * 9999).toFixed(2));\r",
              "\r",
              "}\r",
              "\r",
              "var postType = pm.environment.get(\"post_run_type\");\r",
              "\r",
              "var instock = Math.random() < 0.5;\r",
              "\r",
              "if (postType === \"positive\") {\r",
              "\r",
              "    pm.variables.set(\"put_name\", randomString(\"UpdatedProduct\"));\r",
              "\r",
              "    pm.variables.set(\"put_category\", randomString(\"UpdatedCategory\"));\r",
              "\r",
              "    pm.variables.set(\"put_price\", randomValidPrice());\r",
              "\r",
              "    pm.variables.set(\"put_test_type\", \"positive\");\r",
              "\r",
              "    pm.variables.set(\"put_expected_status\", \"200\");\r",
              "\r",
              "} else {\r",
              "\r",
              "    var invalidField = Math.floor(Math.random() * 3);\r",
              "\r",
              "    if (invalidField === 0) {\r",
              "\r",
              "        pm.variables.set(\"put_name\", randomInvalidName());\r",
              "\r",
              "        pm.variables.set(\"put_category\", randomString(\"UpdatedCategory\"));\r",
              "\r",
              "        pm.variables.set(\"put_price\", randomValidPrice());\r",
              "\r",
              "    } else if (invalidField === 1) {\r",
              "\r",
              "        pm.variables.set(\"put_name\", randomString(\"UpdatedProduct\"));\r",
              "\r",
              "        pm.variables.set(\"put_category\", randomInvalidCategory());\r",
              "\r",
              "        pm.variables.set(\"put_price\", randomValidPrice());\r",
              "\r",
              "    } else {\r",
              "\r",
              "        pm.variables.set(\"put_name\", randomString(\"UpdatedProduct\"));\r",
              "\r",
              "        pm.variables.set(\"put_category\", randomString(\"UpdatedCategory\"));\r",
              "\r",
              "        pm.variables.set(\"put_price\", randomInvalidPrice());\r",
              "\r",
              "    }\r",
              "\r",
              "    pm.variables.set(\"put_test_type\", \"negative\");\r",
              "\r",
              "    pm.variables.set(\"put_expected_status\", \"400\");\r",
              "\r",
              "}\r",
              "\r",
              "pm.variables.set(\"put_instock\", instock);\r",
              "\r",
              "})();"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "(function () {",
              "",
              "var response = pm.response.json();",
              "",
              "var testType = pm.variables.get(\"put_test_type\");",
              "",
              "var expectedStatus = Number(pm.variables.get(\"put_expected_status\"));",
              "",
              "pm.test(\"PUT - Expected Status Code\", function () {",
              "",
              "    pm.expect(pm.response.code).to.eql(expectedStatus);",
              "",
              "});",
              "",
              "if (testType === \"negative\") {",
              "",
              "    pm.test(\"PUT - Negative Validation\", function () {",
              "",
              "        pm.expect(pm.response.code).to.eql(400);",
              "",
              "    });",
              "",
              "}",
              "",
              "if (response.data && response.data.data) {",
              "",
              "    var schema = {",
              "",
              "        type: \"object\",",
              "",
              "        required: [\"data\"],",
              "",
              "        properties: {",
              "",
              "            data: {",
              "",
              "                type: \"object\",",
              "",
              "                required: [\"id\", \"data\"],",
              "",
              "                properties: {",
              "",
              "                    id: {",
              "",
              "                        type: \"string\",",
              "",
              "                        minLength: 1",
              "",
              "                    },",
              "",
              "                    data: {",
              "",
              "                        type: \"object\",",
              "",
              "                        required: [\"name\", \"category\", \"price\", \"instock\"],",
              "",
              "                        properties: {",
              "",
              "                            name: {",
              "",
              "                                type: \"string\",",
              "",
              "                                minLength: 1,",
              "",
              "                                pattern: \"^[A-Za-z0-9 _-]+$\"",
              "",
              "                            },",
              "",
              "                            category: {",
              "",
              "                                type: \"string\",",
              "",
              "                                minLength: 1,",
              "",
              "                                pattern: \"^[A-Za-z0-9 _-]+$\"",
              "",
              "                            },",
              "",
              "                            price: {",
              "",
              "                                type: \"number\",",
              "",
              "                                minimum: 0",
              "",
              "                            },",
              "",
              "                            instock: {",
              "",
              "                                type: \"boolean\"",
              "",
              "                            }",
              "",
              "                        }",
              "",
              "                    }",
              "",
              "                }",
              "",
              "            }",
              "",
              "        }",
              "",
              "    };",
              "",
              "    pm.test(\"PUT - Schema Validation\", function () {",
              "",
              "        pm.response.to.have.jsonSchema(schema);",
              "",
              "    });",
              "",
              "    pm.test(\"PUT - ID Field Validation\", function () {",
              "",
              "        pm.expect(response.data.id).to.be.a(\"string\");",
              "",
              "        pm.expect(response.data.id.length).to.be.above(0);",
              "",
              "    });",
              "",
              "    pm.test(\"PUT - Name Field Validation\", function () {",
              "",
              "        pm.expect(response.data.data.name).to.be.a(\"string\");",
              "",
              "        pm.expect(response.data.data.name.length).to.be.above(0);",
              "",
              "        pm.expect(response.data.data.name).to.match(/^[A-Za-z0-9 _-]+$/);",
              "",
              "    });",
              "",
              "    pm.test(\"PUT - Category Field Validation\", function () {",
              "",
              "        pm.expect(response.data.data.category).to.be.a(\"string\");",
              "",
              "        pm.expect(response.data.data.category.length).to.be.above(0);",
              "",
              "        pm.expect(response.data.data.category).to.match(/^[A-Za-z0-9 _-]+$/);",
              "",
              "    });",
              "",
              "    pm.test(\"PUT - Price Field Validation\", function () {",
              "",
              "        pm.expect(response.data.data.price).to.be.a(\"number\");",
              "",
              "        pm.expect(response.data.data.price).to.be.at.least(0);",
              "",
              "    });",
              "",
              "    pm.test(\"PUT - Instock Field Validation\", function () {",
              "",
              "        pm.expect(response.data.data.instock).to.be.a(\"boolean\");",
              "",
              "    });",
              "",
              "    pm.test(\"PUT - Name Matches Request\", function () {",
              "",
              "        pm.expect(response.data.data.name).to.eql(pm.variables.get(\"put_name\"));",
              "",
              "    });",
              "",
              "    pm.test(\"PUT - Category Matches Request\", function () {",
              "",
              "        pm.expect(response.data.data.category).to.eql(pm.variables.get(\"put_category\"));",
              "",
              "    });",
              "",
              "    pm.test(\"PUT - Price Matches Request\", function () {",
              "",
              "        pm.expect(Number(response.data.data.price)).to.eql(Number(pm.variables.get(\"put_price\")));",
              "",
              "    });",
              "",
              "    pm.test(\"PUT - Instock Matches Request\", function () {",
              "",
              "        pm.expect(response.data.data.instock).to.eql(pm.variables.get(\"put_instock\"));",
              "",
              "    });",
              "",
              "    pm.environment.set(\"updated_id\", response.data.id);",
              "",
              "    pm.environment.set(\"updated_name\", response.data.data.name);",
              "",
              "    pm.environment.set(\"updated_category\", response.data.data.category);",
              "",
              "    pm.environment.set(\"updated_price\", response.data.data.price);",
              "",
              "    pm.environment.set(\"updated_instock\", response.data.data.instock);",
              "",
              "}",
              "",
              "})();"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
