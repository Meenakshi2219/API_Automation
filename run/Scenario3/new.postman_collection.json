              "",
              "                        minLength: 1",
              "",
              "                    },",
              "",
              "                    data: {",
              "",
              "                        type: \"object\",",
              "",
              "                        required: [\"name\", \"category\", \"price\", \"instock\"],",
              "",
              "                        properties: {",
              "",
              "                            name: {",
              "",
              "                                type: \"string\",",
              "",
              "                                minLength: 1,",
              "",
              "                                pattern: \"^[A-Za-z0-9 _-]+$\"",
              "",
              "                            },",
              "",
              "                            category: {",
              "",
              "                                type: \"string\",",
              "",
              "                                minLength: 1,",
              "",
              "                                pattern: \"^[A-Za-z0-9 _-]+$\"",
              "",
              "                            },",
              "",
              "                            price: {",
              "",
              "                                type: \"number\",",
              "",
              "                                minimum: 0",
              "",
              "                            },",
              "",
              "                            instock: {",
              "",
              "                                type: \"boolean\"",
              "",
              "                            }",
              "",
              "                        }",
              "",
              "                    }",
              "",
              "                }",
              "",
              "            }",
              "",
              "        }",
              "",
              "    };",
